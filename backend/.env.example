APP_NAME=ClinicBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite works out of the box (zero setup).
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL / MariaDB — recommended, matches the job description.
# Switch to these when deploying or when practicing with MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=clinicbook
# DB_USERNAME=root
# DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_DOMAIN=
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000
FRONTEND_URL=http://localhost:5173
